      "quantization": "ollama-default-q4",
      "notes": "7B in the quantized Ollama tag only."
    },
    {
      "id": "mid",
      "min_vram_gb_inclusive": 11,
      "max_vram_gb_inclusive": 15,
      "ollama_tag": "deepseek-r1:7b",
