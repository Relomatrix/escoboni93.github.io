    {
      "id": "high",
      "min_vram_gb_inclusive": 16,
      "ollama_tag": "deepseek-r1:7b",
      "upstream_hf": "deepseek-ai/DeepSeek-R1-Distill-Qwen-7B",
      "quantization": "ollama-default-q4",
